# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Hosted app only (D34): the shared code testers type at /invite. Leave unset locally to skip the gate.
INVITE_CODE=
# Hosted app only (D48): a private Vercel Blob store for traces. Connecting the store to the project sets
# this on Vercel; `vercel env pull` copies it here so `npm run traces` can download traces.
BLOB_READ_WRITE_TOKEN=
